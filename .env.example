# Copy this file to .env and fill values (DO NOT commit secrets)
# Appwrite credentials
APPWRITE_API_KEY=your_appwrite_api_key_here
APPWRITE_PROJECT_ID=your_project_id_here
APPWRITE_DATABASE_ID=your_database_id_here
APPWRITE_COLLECTION_ID=your_collection_id_here
APPWRITE_EMPLOYEE_COLLECTION_ID=your_employee_collection_id_here
APPWRITE_REQUEST_HEADER_COLLECTION_ID=your_request_header_collection_id_here
APPWRITE_REQUEST_DETAILS_COLLECTION_ID=your_request_details_collection_id_here
APPWRITE_PRODUCT_COLLECTION_ID=your_product_collection_id_here
APPWRITE_CATEGORY_COLLECTION_ID=your_category_collection_id_here
APPWRITE_MEASURE_UNIT_COLLECTION_ID=your_measure_unit_collection_id_here
APPWRITE_AUDIT_TRAIL_COLLECTION_ID=your_audit_trail_collection_id_here
APPWRITE_SUPPLIER_COLLECTION_ID=your_supplier_collection_id_here
APPWRITE_USER_COLLECTION_ID=your_user_collection_id_here

# Security settings
SECURITY_KEY=replace_with_random_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
